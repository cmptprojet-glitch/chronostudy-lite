# Gemini API Key for server-side AI endpoints
GEMINI_API_KEY=

# HTTP server
PORT=3000
NODE_ENV=development

# Transitional local demo only; never enable in production
ENABLE_DEMO_USER=false

# Supabase Phase 1 (keep service-role key server-side only)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
